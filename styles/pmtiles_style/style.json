    {
      "id": "transportation",
      "type": "line",
      "source": "topo",
      "source-layer": "transportation",
      "filter": ["!", ["in", ["get", "class"], ["literal", ["path", "footway", "bridleway", "steps"]]]],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": [
          "match", ["get", "class"],
          "motorway", "#e08040", "trunk", "#e8a060", "primary", "#f0c060",
          "secondary", "#f4d488", "tertiary", "#ffffff",
          "railway", "#777777", "aerialway", "#888888",
          "track", "#9c6800",
          "#cfcabf"
        ],
        "line-width": [
          "interpolate", ["linear"], ["zoom"],
          8, ["match", ["get", "class"], "motorway", 1.5, "trunk", 1.2, 0.4],
          14, ["match", ["get", "class"], "motorway", 5, "trunk", 4, "primary", 3, "secondary", 2.5, "track", 1, 1.2],
          18, ["match", ["get", "class"], "motorway", 9, "trunk", 8, "primary", 6, "secondary", 5, 2.5]
        ]
      }
    },
    {
      "id": "trail",
      "type": "line",
      "source": "topo",
      "source-layer": "transportation",
      "filter": ["in", ["get", "class"], ["literal", ["path", "footway", "bridleway", "steps"]]],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#9c6800",
        "line-width": ["interpolate", ["linear"], ["zoom"], 12, 0.6, 16, 1.6, 20, 3],
        "line-dasharray": [2, 1.5]
      }
    },

    {
      "id": "hiking-route",
      "type": "line",
      "source": "topo",
      "source-layer": "hiking_route",
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": { "line-color": "#d04030", "line-width": ["interpolate", ["linear"], ["zoom"], 11, 1.5, 14, 3, 18, 5], "line-opacity": 0.55 }
    },
    {
      "id": "cycle-route",
      "type": "line",
      "source": "topo",
      "source-layer": "cycle_route",
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": { "line-color": "#3050c0", "line-width": ["interpolate", ["linear"], ["zoom"], 12, 1.5, 14, 3, 18, 5], "line-opacity": 0.45 }
    },

    {
      "id": "ele-point",
      "type": "symbol",
      "source": "topo",
      "source-layer": "ele_point",
      "filter": ["all",
        ["in", ["get", "class"], ["literal", ["summit_board", "peak", "volcano", "saddle", "mountain_pass", "survey_point", "ele_marker"]]],
        ["any", ["has", "name"], ["has", "ele"]]],
      "layout": {
        "symbol-sort-key": ["match", ["get", "class"],
          "summit_board", ["coalesce", ["get", "zl"], 3],
          "peak", 4, "volcano", 4, "saddle", 4, "mountain_pass", 4,
          "survey_point", 6,
          5],
        "text-field": ["case",
          ["==", ["get", "class"], "summit_board"], ["get", "name"],
          ["all", ["has", "name"], ["!=", ["get", "class"], "survey_point"], ["has", "ele"]],
            ["concat", ["get", "name"], "\n", ["to-string", ["get", "ele"]], " m"],
          ["all", ["has", "name"], ["!=", ["get", "class"], "survey_point"]], ["get", "name"],
          ["concat", ["to-string", ["get", "ele"]], " m"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["case", ["all", ["==", ["get", "class"], "summit_board"], ["<=", ["coalesce", ["get", "zl"], 3], 1]], 12, 11],
        "text-anchor": "left",
        "text-offset": [0.6, 0]
      },
      "paint": {
        "text-color": "#5a3a1a",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.2
      }
    },
    {
      "id": "poi",
      "type": "symbol",
      "source": "topo",
      "source-layer": "poi",
      "minzoom": 14,
      "layout": { "text-field": ["get", "name"], "text-font": ["Noto Sans Regular"], "text-size": 10, "text-anchor": "top", "text-offset": [0, 0.6] },
      "paint": { "text-color": "#555555", "text-halo-color": "#ffffff", "text-halo-width": 1 }
    },
    {
      "id": "place",
      "type": "symbol",
      "source": "topo",
      "source-layer": "place",
      "layout": {
        "text-field": ["get", "name"], "text-font": ["Noto Sans Regular"],
        "text-size": ["match", ["get", "class"], "city", 16, "town", 13, "village", 11, 10]
      },
      "paint": { "text-color": "#2a2a2a", "text-halo-color": "#ffffff", "text-halo-width": 1.5 }
    }
  ]
}
